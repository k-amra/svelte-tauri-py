{
	"name": "tauri2-svelte5-shadcn",
	"private": true,
	"version": "2.1.1",
	"packageManager": "bun@1.4.2",
	"description": "A simple desktop application template combining Tauri 2 with Svelte 5 and shadcn-svelte with a basic ci/cd implemented.",
	"author": {
		"name": "Alysonhower Veras Vieira",
		"email": "contato@alysonhower.dev"
	},
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build:frontend": "vite build",
		"build:sidecar": "bun scripts/build-sidecar.mjs",
		"build": "bun run build:sidecar && bun run build:frontend",
		"tauri:dev": "cross-env SIDECAR_DEV=1 tauri dev",
		"tauri:dev:binary": "tauri dev",
		"tauri:build": "bun run build:sidecar && tauri build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"tauri": "tauri",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
		"test:python": "uv run --project src-python pytest -q",
		"test:check": "bun run check && bun run lint",
		"test": "bun run test:check && bun run test:unit && bun run test:rust && bun run test:python",
		"gen:types": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/lib/api/types.ts",
		"version": "bun scripts/sync-versions.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^0.577.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tauri-apps/cli": "^2.11.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@tsconfig/svelte": "^5.0.8",
		"cross-env": "^10.1.0",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"jsdom": "^29.1.1",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.53.11",
		"svelte-check": "^4.4.5",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^8.0.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.2.1",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-shell": "^2.3.6",
		"@types/node": "^25.5.0",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.1"
	}
}
