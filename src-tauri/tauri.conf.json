{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "tauri2-svelte5-shadcn",
	"version": "2.2.1",
	"identifier": "dev.alysonhower.chatstats",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build:sidecar && bun run build:frontend"
	},
	"app": {
		"windows": [
			{
				"title": "tauri2-svelte5-shadcn",
				"width": 1024,
				"height": 720,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"windows": {
			"signCommand": {
				"cmd": "powershell",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"..\\scripts\\sign-bundle.ps1",
					"%1"
				]
			}
		},
		"externalBin": [
			"binaries/api-server"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
